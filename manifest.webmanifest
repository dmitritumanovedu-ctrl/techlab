{
  "id": "./",
  "name": "TechLab — уроки, тесты и квесты",
  "short_name": "TechLab",
  "description": "Школьная платформа для уроков информатики, географии и технологического воспитания: тесты, квесты, практические работы, опыт и награды для учеников, кабинет родителя.",
  "lang": "ru",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EEF2F8",
  "theme_color": "#2E4BFF",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "dir": "ltr",
